# ==========================================================================
# 1000 LB CLUB — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local.
# ==========================================================================

# --- Supabase (public, safe to expose to the browser) ---------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" public API key. Safe for the client; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (SERVER ONLY — never exposed to the client) -----
# The "service_role" secret key. Bypasses RLS. Used only in server routes and
# admin server actions for trusted writes (posts, comments, verification review).
# If this ever reaches the client bundle, it is a critical security breach.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin gate (SERVER ONLY) ---------------------------------------------
# Numeric password for the /admin login. Compared server-side only.
ADMIN_PASSWORD=123456
# Random 32-byte secret used to sign the admin session cookie.
# Generate with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- App ------------------------------------------------------------------
# Public base URL of the deployed site, used for OAuth redirects.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
